    /*plot(bba(nxg) + bbb(nxg) + bbc(nxg) +bbd(nxg) +a1(nxg*0.1) +ab1(arcpts)+b1(nyg*0.5)+bc1(arcpts)+c1(nxg*0.1)+cd1(arcpts) +d1(nyg*0.5)+ad1(arcpts)+a2(nxg*0.1)
    +ab2(arcpts) +b2(nyg*0.5)+bc2(arcpts)+c2(nxg*0.1)+cd2(arcpts) +d2(nyg*0.5) +ad2(arcpts),ps="orientation.pdf");
    exit(0);*/
    Th=Th2g+Th2;
    int itmaxrays=1;
    for (int adl=0;adl<itmaxrays;adl++){

