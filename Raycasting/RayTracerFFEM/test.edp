    {
    //int nxg = nx*(length+lengthpml[0]+lengthpml[1])/length;
    int nxg = (1./hp)*(length+lengthpml[0]+lengthpml[1])/length;
    int nyg = (1./hp)*(length+lengthpml[0]+lengthpml[1])/length;

    border ag(t=-lengthpml[0],length+lengthpml[1]) {x=t; y=-lengthpml[2]; label=lab[0];}
    border bg(t=-lengthpml[2],length+lengthpml[3]) {x=length+lengthpml[1]; y=t; label=lab[1];}
    border cg(t=length+lengthpml[1],-lengthpml[0]) {x=t; y=length+lengthpml[3]; label=lab[2];}
    border dg(t=length+lengthpml[3],-lengthpml[2]) {x=-lengthpml[0]; y=t; label=lab[3];}

    // Mesh
    border bba(t=0, length){x=t;   y=0;   label=ABC;}
    border bbb(t=0, length){x=length;   y=t;   label=ABC;}
    border bbc(t=0, length){x=length-t; y=length; label=ABC;}
    border bbd(t=0, length){x=0; y=length-t;   label=ABC;}

    border a1(t=0.05, 0.15){x=0.4-t;   y=0.2;   label=RBC;}
    border b1(t=0.25,0.75 ){x=0.2;   y=t;   label=RBC;}

    border c1(t=0.05, 0.15){x=0.2+t; y=0.8; label=RBC;}
    border d1(t=0.05, 0.55){x=0.4; y=0.8-t;   label=RBC;}

    border a2(t=0.05, 0.15){x=0.8-t;   y=0.2;   label=RBC;}
