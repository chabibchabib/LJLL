            func functest = (tabh2[][nuTriangle] )? hk:((tabh[][nuTriangle])? hv : hi );
            Th=adaptmesh(Th2, functest , IsMetric=1 ,requirededges=arclabs);
            meshL ThL= extract(Th);
            meshL Thl= buildmeshL(ag(nxg)+bg(nxg)+cg(nxg)+dg(nxg)) ;
            ThL= trunc(ThL,region==ABC);
            ThL=ThL+Thl;
            mesh ThPML= buildmesh(ThL,fixedborder=1);
            int reg = ThPML(0.5,0.5).region;
            ThPML= trunc(ThPML,region!=reg);
            Th2=Th;
            Th=ThPML+Th;
            plot(Th,cmm="Mesh it "+ adl,ps="Mesh_raycasting_it"+adl+".pdf");
        } // end for adl

    }

        Uh up = sqrt((x-xs)^2+(y-ys)^2);
        int ind = up[].imin;
        real epst = 1e-10;
        ffddmbuildDmesh(prmesh,Th,mpiCommWorld)
        ffddmbuildDfespace(prmesh,prmesh,complex,def,init,Pk)
        prmesh#Vhi<complex> u, x0, rhs, uex, udiff;

        x0[] = 0;

        //Th = square(1,1);

EndMacro
