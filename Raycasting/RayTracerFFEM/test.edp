int traporder=2;
func real[int] QuasiOptimality(int k, int p, int traporder)
{
    real[int] hsteps(4);
    hsteps[0] = k^(-(1+real(traporder)/p));
    hsteps[1] = k^( -(1+(traporder+1.)/(2*p)));
    hsteps[2] = k^(-(1+1./p));
    hsteps[3] = 1./k;
    return hsteps;
};

