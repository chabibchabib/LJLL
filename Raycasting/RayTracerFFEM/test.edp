NewMacro GenerateMesh(prmesh)

    IFMACRO(!oneD)
    lpmlg = lpmlgparam;
    ENDIFMACRO
    IFMACRO(oneD)
    lpmlg = lpmlgoneD;
    ENDIFMACRO

    /*real[int] lengthpml(4); // length of global PML
    for (int i=0; i<4; i++) lengthpml[i] = lpmlg;*/
    
    // calcules a partir des formules avec k=20 / p=6
    /*real[int] steps=QuasiOptimality( k,  pkorder, traporder);
    real hk=steps[0];
