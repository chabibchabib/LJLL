load"raytracer"
mesh Th = square(2, 2);
//MeshArgs(Th);
int nbTriangles = Th.nt;
int[int]  tab(nbTriangles);
for (int i=0;i<nbTriangles;i++) tab[i]=0;
int it=0;
real[int]  RayRef(4);
RayRef[0]=0.25; 
RayRef[1]=0.25;
RayRef[2]=0.;
RayRef[3]=1.;
int tt=0;
tt= RayTracer(Th,it, RayRef,tab);
plot(Th);
//cout<<"TT="<<tt<<endl;
for (int i=0;i<nbTriangles;i++) cout<<" tab["<<i<<"]="<<tab[i]<<" ";
cout<<endl;
