NewMacro GenerateSimpleMesh(prmesh)
    IFMACRO(!oneD)
    lpmlg = lpmlgparam;
    ENDIFMACRO
    IFMACRO(oneD)
    lpmlg = lpmlgoneD;
    ENDIFMACRO

    real[int] lengthpml(4); // length of global PML
    for (int i=0; i<4; i++) lengthpml[i] = lpmlg;
    real[int] steps=QuasiOptimality( k,  pkorder, traporder);
    real hk=steps[0];
    real hv=steps[1];
    real hi=steps[2];
    real hp=steps[3];

    int nxg = (1./hk)*(length+lengthpml[0]+lengthpml[1])/length;
    int nyg = (1./hk)*(length+lengthpml[0]+lengthpml[1])/length;

    border agr(t=-lengthpml[0],length+lengthpml[1]) {x=t; y=-lengthpml[2]; label=lab[0];}
    border bgr(t=-lengthpml[2],length+lengthpml[3]) {x=length+lengthpml[1]; y=t; label=lab[1];}
    border cgr(t=length+lengthpml[1],-lengthpml[0]) {x=t; y=length+lengthpml[3]; label=lab[2];}
    border dgr(t=length+lengthpml[3],-lengthpml[2]) {x=-lengthpml[0]; y=t; label=lab[3];}

    // Mesh
    border bbar(t=0, length){x=t;   y=0;   label=ABC;}
    border bbbr(t=0, length){x=length;   y=t;   label=ABC;}
    border bbcr(t=0, length){x=length-t; y=length; label=ABC;}
    border bbdr(t=0, length){x=0; y=length-t;   label=ABC;}

    /*border a1r(t=0, 0.2){x=0.4-t;   y=0.2;   label=RBC;}
    border b1r(t=0.2,0.8 ){x=0.2;   y=t;   label=RBC;}
    border c1r(t=0, 0.2){x=0.2+t; y=0.8; label=RBC;}
    border d1r(t=0, 0.6){x=0.4; y=0.8-t;   label=RBC;}

    border a2r(t=0, 0.2){x=0.8-t;   y=0.2;   label=RBC;}
    border b2r(t=0.2,0.8 ){x=0.6;   y=t;   label=RBC;}
    border c2r(t=0, 0.2){x=0.6+t; y=0.8; label=RBC;}
    border d2r(t=0, 0.6){x=0.8; y=0.8-t;   label=RBC;}*/

    border a1r(t=0.05, 0.15){x=0.4-t;   y=0.2;   label=RBC;}
    border b1r(t=0.25,0.75 ){x=0.2;   y=t;   label=RBC;}

    border c1r(t=0.05, 0.15){x=0.2+t; y=0.8; label=RBC;}
    border d1r(t=0.05, 0.55){x=0.4; y=0.8-t;   label=RBC;}

    border a2r(t=0.05, 0.15){x=0.8-t;   y=0.2;   label=RBC;}
    border b2r(t=0.25,0.75 ){x=0.6;   y=t;   label=RBC;}
    border c2r(t=0.05, 0.15){x=0.6+t; y=0.8; label=RBC;}
    border d2r(t=0.05, 0.55){x=0.8; y=0.8-t;   label=RBC;}
    
    
    border ad1r(t=0,-pi/2 ){x=0.35+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}
    border cd1r(t= pi/2,0 ){x=0.35+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border bc1r(t=pi,pi/2 ){x=0.25+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border ab1r(t=-pi/2 ,-pi){x=0.25+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}
    border ad2r(t=0,-pi/2 ){x=0.75+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}
    border cd2r(t= pi/2,0 ){x=0.75+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border bc2r(t=pi,pi/2 ){x=0.65+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border ab2r(t=-pi/2 ,-pi){x=0.65+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}

    mesh Th2gr = buildmesh(bbar(-nxg)+bbbr(-nxg)+bbcr(-nxg)+bbdr(-nxg)+agr(nxg)+bgr(nxg)+cgr(nxg)+dgr(nxg),fixedborder=1,nbvx=10000000);
    mesh Th2r = buildmesh (bbar(nxg) + bbbr(nxg) + bbcr(nxg) +bbdr(nxg) +a1r(nxg*0.1) +ab1r(arcpts)+b1r(nyg*0.5)+bc1r(arcpts)+c1r(nxg*0.1)+cd1r(arcpts) +d1r(nyg*0.5)+ad1r(arcpts)+a2r(nxg*0.1)
    +ab2r(arcpts) +b2r(nyg*0.5)+bc2r(arcpts)+c2r(nxg*0.1)+cd2r(arcpts) +d2r(nyg*0.5) +ad2r(arcpts),fixedborder=1,nbvx=10000000 );

    //mesh Th2gr = buildmesh(bbar(-nxg)+bbbr(-nxg)+bbcr(-nxg)+bbdr(-nxg)+agr(nxg)+bgr(nxg)+cgr(nxg)+dgr(nxg),fixedborder=1,nbvx=10000000);
    //mesh Th2r = buildmesh (bbar(nxg) + bbbr(nxg) + bbcr(nxg) +bbdr(nxg) +a1r(nxg*0.2) +b1r(nyg*0.6)+c1r(nxg*0.2) +d1r(nyg*0.6)  +a2r(nxg*0.2) +b2r(nyg*0.6)+c2r(nxg*0.2) +d2r(nyg*0.6),fixedborder=1,nbvx=10000000 );
    Thref=Th2gr+Th2r;
    func functest = hk;
    Thref=adaptmesh(Thref, functest , IsMetric=1 ,nbvx=100000000,requirededges=arclabs);
    ffddmbuildDmesh(prmesh,Thref,mpiCommWorld)
    ffddmbuildDfespace(prmesh,prmesh,complex,def,init,Pk)
    prmesh#Vhi<complex> us, x0s, rhss, uexs, udiffs;
    x0s[] = 0;
    plot(Thref,cmm="Reference Mesh ",ps="reference_mesh.pdf");


EndMacro


NewMacro Generate(pr,prmesh,UREF,U,X0,UDIFF,RHS,UH)

        /*macro sigmag(u) (c/k/max(epst,lpmlg-(u)))//EOM
        macro dsigmag(u) (u)//EOM
        macro sigmaCAP(u) (0)//EOM*/


        IFMACRO(MSMOOTH)
        macro sigma(u) (alpha*exp(-1./(beta*abs(u)+1e-10)))//EOM
        macro dsigma(u) (beta/(beta*abs(u)+1e-10)^2*sigma(u))//EOM
        ENDIFMACRO

        IFMACRO(oneD)
        real aCAP = 1-16/C^3;
        real bCAP = (1-17/C^3)/C^2;
        macro xCAP(u) (2*deltaCAP*k0*(u+1e-10))//
        macro yCAP(u) (aCAP*(xCAP(u))-bCAP*(xCAP(u))^3+4/(C-xCAP(u))^2-4/(C+xCAP(u))^2)//
        macro sigma(u) (yCAP(u))//EOM
        macro dsigma(u) (0*csigma*(u))//EOM
        ENDIFMACRO

        IFMACRO((!MSMOOTH)&(!oneD))
        macro sigma(u) (c/k/max(epst,lpmlg-(u)))//EOM
        macro dsigma(u) (0)//EOM
        ENDIFMACRO

        IFMACRO(MPML)
        macro sigmag(u) sigma(u)//EOM
        macro dsigmag(u) dsigma(u)//EOM
        macro sigmaCAP(u) (0)//EOM
        Robin = bnull;
        Dirichlet = bgamma;
        ENDIFMACRO

        IFMACRO(MCAP)
        macro sigmag(u) (0)//EOM
        macro dsigmag(u) (1)//EOM
        macro sigmaCAP(u) sigma(u)//EOM
        Robin = bnull;
        Dirichlet = bgamma;
        ENDIFMACRO

        IFMACRO(MIMP)
        macro sigmag(u) (0)//EOM
        macro dsigmag(u) (1)//EOM
        macro sigmaCAP(u) (0)//EOM
        Robin = bgamma;
        Dirichlet = bnull;
        ENDIFMACRO

        func sigmax = (x>=length)*sigmag(x-length)  +  (x<=0)*sigmag(-x);
        func sigmay = (y>=length)*sigmag(y-length)  +  (y<=0)*sigmag(-y);

        func dsigmax = (x>=length)*dsigmag(x-length)  -  (x<=0)*dsigmag(-x);
        func dsigmay = (y>=length)*dsigmag(y-length)  -  (y<=0)*dsigmag(-y);

        func gammax = 1+1i*sigmax;
        func gammay = 1+1i*sigmay;

        func dgammax = 1i*dsigmax;
        func dgammay = 1i*dsigmay;

        func sigmaCAPx = (x>=length)*sigmaCAP(x-length)  +  (x<=0)*sigmaCAP(-x);
        func sigmaCAPy = (y>=length)*sigmaCAP(y-length)  +  (y<=0)*sigmaCAP(-y);

        func fCAP = sigmaCAPx + sigmaCAPy;

        macro Grad(u) [dx(u),dy(u)] // EOM
        macro Gradpml(u) [1./gammax^2*dx(u),
                          1./gammay^2*dy(u)] // EOM
        macro Betapml(u) (dgammax/gammax^3*dx(u) + dgammay/gammay^3*dy(u)) // EOM

        macro GradpmlB(u) [gammay/gammax*dx(u),
                           gammax/gammay*dy(u)] // EOM

        macro Varf(varfName, meshName, PhName)
            varf varfName(u,v) =
          int2d(meshName,qforder=qorder)(-1./c^2*u*v+1./k^2*Grad(u)'*Gradpml(v)-1./k^2*Betapml(u)*v - 1i*fCAP*u*v)
        				- int1d(meshName,Robin,PML,Dirichlet,qforder=qorder)(1i*1./(k*c)*u*v); // EOM

        // for the preconditioner
        macro VarfOpt(varfName, meshName, PhName)
            varf varfName(u,v) =
          int2d(meshName,qforder=qorder)(-1./c^2*u*v+1./k^2*Grad(u)'*Gradpml(v)-1./k^2*Betapml(u)*v - 1i*fCAP*u*v)
        				- int1d(meshName,Robin,PML,Dirichlet,10,qforder=qorder)(1i*1./(k*c)*u*v); // EOM

        macro VarfB(varfName, meshName, PhName)
            varf varfName(u,v) =
          int2d(meshName,qforder=qorder)(-1./c^2*gammax*gammay*u*v+1./k^2*Grad(u)'*GradpmlB(v) - 1i*fCAP*u*v)
        				- int1d(meshName,Robin,PML,Dirichlet,qforder=qorder)(1i*gammax*gammay*1./(k*c)*u*v); // EOM

        // for the preconditioner
        macro VarfOptB(varfName, meshName, PhName)
            varf varfName(u,v) =
          int2d(meshName,qforder=qorder)(-1./c^2*gammax*gammay*u*v+1./k^2*Grad(u)'*GradpmlB(v) - 1i*fCAP*u*v)
        				- int1d(meshName,Robin,PML,Dirichlet,10,qforder=qorder)(1i*gammax*gammay*1./(k*c)*u*v); // EOM

        macro Varfrhs(varfName, meshName, PhName)
            varf varfName(u,v) =
          int2d(meshName,qforder=qorder)((x>0)*(x<length)*(y>0)*(y<length)*rhscst*gslsfbesselJ0(k*sqrt((x-xs)^2+(y-ys)^2))*v); // EOM

        vsym = 2;
        vtgv = -2;
        vtgvelim = -2;

        UH upss = sqrt((x-xs)^2+(y-ys)^2);
        int inds = upss[].imin;
        real epst = 1e-10;

        prmesh#Vhglob<complex> rhsg = 0;
        rhsg[][inds] = 1./(k0^2);

        IFMACRO(!MSYM)
        //ffddmsetupOperator(pr,prmesh,Varf)
        ffddmsetup(pr,prmesh,Varf,VarfOpt)
        ENDIFMACRO

        IFMACRO(MSYM)
        //ffddmsetupOperator(pr,prmesh,VarfB)
        ffddmsetup(pr,prmesh,VarfB,VarfOptB)
        ENDIFMACRO

        RHS[] = prmesh#Rih[mpiRank(prmesh#commddm)]*rhsg[];

        ffddmbuildrhs(pr,Varfrhs,RHS[])

        U[] = pr#fGMRES(X0[], RHS[], 1.e-10, 400, "right");
        //u[] = pr#directsolve(rhs[]);

        //pr#writesummary

        real epsb = 0.05;
        func supp = (sqrt((x-xs)^2+(y-ys)^2) > 1e-2) && (x > epsb) && (x < length-epsb) && (y > epsb) && (y < length-epsb);

        //u = u * supp;

        func dd = sqrt((x-xs)^2+(y-ys)^2) > 1e-5 ? sqrt((x-xs)^2+(y-ys)^2) : 1e-5;

        //func uex = 1i*1./4*(gslsfbesselJn(0,k0*dd)+1i*gslsfbesselYn(0,k0*dd));

        func uex = UREF;

        complex erri = int2d(prmesh#Thi,qforder=qorder)(supp*prmesh#DP1[mpiRank(prmesh#commddm)]*(U-uex)^2), uexi = int2d(prmesh#Thi,qforder=qorder)(supp*prmesh#DP1[mpiRank(prmesh#commddm)]*uex^2);
        complex errg = 0, uexg = 0;
        mpiAllReduce(erri,errg,prmesh#commddm,mpiSUM);
        mpiAllReduce(uexi,uexg,prmesh#commddm,mpiSUM);

        err = abs(sqrt(errg))/abs(sqrt(uexg));

        if (mpirank == 0) cout << Stringification(pr) +" ERROR = "+err << endl;

        ffddmplot(prmesh,real(U), Stringification(pr)+" u, err = "+err);

        ffddmplot(prmesh,real(uex), Stringification(pr)+" uex, err = "+err);

        UDIFF = U - uex;
        UDIFF = abs(UDIFF)*supp;
        ffddmplot(prmesh,real(UDIFF), "alpha = " + alpha + ", beta = " + beta + ",err = "+err);
        prmesh#Vhglob<complex> UDIFFG;
        prmesh#Vhglob<real> UDIFFGR;

        pr#fromVhi(UDIFF[],prmesh#Vhglob,UDIFFG[])
        UDIFFGR[]=UDIFFG[].re;
        plot(UDIFFGR,fill=1,value=1, ps="sol_"+Stringification(prmesh)+".pdf");
        //ffddmplot(prmesh,real(uex), "exact solution");


EndMacro

NewMacro GenerateCoarserMesh(prmesh, TH, NX,NY)

    IFMACRO(!oneD)
    lpmlg = lpmlgparam;
    ENDIFMACRO
    IFMACRO(oneD)
    lpmlg = lpmlgoneD;
    ENDIFMACRO

    real[int] lengthpmlC(4); // length of global PML
    for (int i=0; i<4; i++) lengthpmlC[i] = lpmlg;

    nxg = NX*(length+lengthpmlC[0]+lengthpmlC[1])/length;
    nyg = NY*(length+lengthpmlC[0]+lengthpmlC[1])/length;

    border agc(t=-lengthpmlC[0],length+lengthpmlC[1]) {x=t; y=-lengthpmlC[2]; label=lab[0];}
    border bgc(t=-lengthpmlC[2],length+lengthpmlC[3]) {x=length+lengthpmlC[1]; y=t; label=lab[1];}
    border cgc(t=length+lengthpmlC[1],-lengthpmlC[0]) {x=t; y=length+lengthpmlC[3]; label=lab[2];}
    border dgc(t=length+lengthpmlC[3],-lengthpmlC[2]) {x=-lengthpmlC[0]; y=t; label=lab[3];}

    // Mesh
    /*border bbac(t=0, length){x=t;   y=0;   label=ABC;}
    border bbbc(t=0, length){x=length;   y=t;   label=ABC;}
    border bbcc(t=0, length){x=length-t; y=length; label=ABC;}
    border bbdc(t=0, length){x=0; y=length-t;   label=ABC;}

    border a1c(t=0, 0.2){x=0.4-t;   y=0.2;   label=RBC;}
    border b1c(t=0.2,0.8 ){x=0.2;   y=t;   label=RBC;}
    border c1c(t=0, 0.2){x=0.2+t; y=0.8; label=RBC;}
    border d1c(t=0, 0.6){x=0.4; y=0.8-t;   label=RBC;}

    border a2c(t=0, 0.2){x=0.8-t;   y=0.2;   label=RBC;}
    border b2c(t=0.2,0.8 ){x=0.6;   y=t;   label=RBC;}
    border c2c(t=0, 0.2){x=0.6+t; y=0.8; label=RBC;}
    border d2c(t=0, 0.6){x=0.8; y=0.8-t;   label=RBC;}
    mesh Th2gc = buildmesh(bbac(-NX)+bbbc(-NX)+bbcc(-NX)+bbdc(-NX)+agc(nxg)+bgc(nxg)+cgc(nxg)+dgc(nxg),fixedborder=1,nbvx=10000000);
    mesh Th2c = buildmesh (bbac(NX) + bbbc(NX) + bbcc(NX) +bbdc(NX) +a1c(NX*0.2) +b1c(NX*0.6)+c1c(NX*0.2) +d1c(NX*0.6)  +a2c(NX*0.2) +b2c(NY*0.6)+c2c(NX*0.2) +d2c(NY*0.6),fixedborder=1,nbvx=10000000 );*/
    
        border ag(t=-lengthpml[0],length+lengthpml[1]) {x=t; y=-lengthpml[2]; label=lab[0];}
    border bg(t=-lengthpml[2],length+lengthpml[3]) {x=length+lengthpml[1]; y=t; label=lab[1];}
    border cg(t=length+lengthpml[1],-lengthpml[0]) {x=t; y=length+lengthpml[3]; label=lab[2];}
    border dg(t=length+lengthpml[3],-lengthpml[2]) {x=-lengthpml[0]; y=t; label=lab[3];}

    // Mesh
    border bbac(t=0, length){x=t;   y=0;   label=ABC;}
    border bbbc(t=0, length){x=length;   y=t;   label=ABC;}
    border bbcc(t=0, length){x=length-t; y=length; label=ABC;}
    border bbdc(t=0, length){x=0; y=length-t;   label=ABC;}

    border a1c(t=0.05, 0.15){x=0.4-t;   y=0.2;   label=RBC;}
    border b1c(t=0.25,0.75 ){x=0.2;   y=t;   label=RBC;}

    border c1c(t=0.05, 0.15){x=0.2+t; y=0.8; label=RBC;}
    border d1c(t=0.05, 0.55){x=0.4; y=0.8-t;   label=RBC;}

    border a2c(t=0.05, 0.15){x=0.8-t;   y=0.2;   label=RBC;}
    border b2c(t=0.25,0.75 ){x=0.6;   y=t;   label=RBC;}
    border c2c(t=0.05, 0.15){x=0.6+t; y=0.8; label=RBC;}
    border d2c(t=0.05, 0.55){x=0.8; y=0.8-t;   label=RBC;}

    border ad1c(t=0,-pi/2 ){x=0.35+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}
    border cd1c(t= pi/2,0 ){x=0.35+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border bc1c(t=pi,pi/2 ){x=0.25+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border ab1c(t=-pi/2 ,-pi){x=0.25+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}

    border ad2c(t=0,-pi/2 ){x=0.75+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}
    border cd2c(t= pi/2,0 ){x=0.75+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border bc2c(t=pi,pi/2 ){x=0.65+0.05*cos(t);   y=0.75+0.05*sin(t);   label=RBC;}
    border ab2c(t=-pi/2 ,-pi){x=0.65+0.05*cos(t);   y=0.25+0.05*sin(t);   label=RBC;}
//arcpts=5;
    mesh Th2gc = buildmesh(bbac(-nxg)+bbbc(-nxg)+bbcc(-nxg)+bbdc(-nxg)+agc(nxg)+bgc(nxg)+cgc(nxg)+dgc(nxg),fixedborder=1,nbvx=10000000);
    mesh Th2c = buildmesh (bbac(nxg) + bbbc(nxg) + bbcc(nxg) +bbdc(nxg) +a1c(nxg*0.1) +ab1c(arcpts)+b1c(nyg*0.5)+bc1c(arcpts)+c1c(nxg*0.1)+cd1c(arcpts) +d1c(nyg*0.5)+ad1c(arcpts)+a2c(nxg*0.1)
    +ab2c(arcpts) +b2c(nyg*0.5)+bc2c(arcpts)+c2c(nxg*0.1)+cd2c(arcpts) +d2c(nyg*0.5) +ad2c(arcpts),fixedborder=1,nbvx=10000000 );
    
    TH=Th2gc+Th2c;

    ffddmbuildDmesh(prmesh,TH,mpiCommWorld)
    ffddmbuildDfespace(prmesh,prmesh,complex,def,init,Pk)
    prmesh#Vhi<complex> uc, x0c, rhsc, uexc, udiffc;
    x0c[] = 0;
    
    plot(TH,cmm="Coarser Mesh ",ps="coarser_mesh.pdf");


EndMacro

lpmlgparam = 1;
lpmlg = lpmlgparam;
beta = 0.6/lpmlg; 

