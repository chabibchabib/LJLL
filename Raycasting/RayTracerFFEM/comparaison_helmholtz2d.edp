int bplot = 0;
mesh Tha = square(1,1);
fespace Uha(Tha,P1);
Uha<complex> ref, usupp;

real alpha = 6.2;
//real beta = 0.6/0.3;
real beta = 0.6/0.6;

load "qf11to25"
load "Element_P3"
load "Element_P4"
load "gsl"
load "iovtk"
load "mpi-cmaes"
load"raytracer"
int qorder = 13;

macro dimension 2// EOM
include "ffddm.idp"

ffddmprecond = "oras";

macro def(i)i// EOM // scalar field definition
macro init(i)i// EOM // scalar field initialization

real waven = getARGV("-waven",40.);
real lpmlgparam = getARGV("-L",1);
real lpmlg = lpmlgparam;
real freq = waven/2/pi;//getARGV("-frequency",10.); // frequency
int nppwl = getARGV("-nppwl",20); // number of points per wavelength
load "msh3"
load "geophysics"

int Dirichlet = 1;
int Robin = 2;
int Neumann = 7;
int PML = 8;
int bgamma = 12;
int bnull = 13;
real c0 = 1.;
//func Pk = P4;
func Pk = P3;
int[int] lab = [bgamma,bgamma,bgamma,bgamma];
real length = 1;
func c  = c0;
real xs = 0.5;
real ys = 0.5;

NewMacro GenerateMesh(prmesh)

      IFMACRO(!oneD)
      lpmlg = lpmlgparam;
      ENDIFMACRO
      IFMACRO(oneD)
      lpmlg = lpmlgoneD;
      ENDIFMACRO

      real[int] lengthpml(4); // length of global PML
      for (int i=0; i<4; i++) lengthpml[i] = lpmlg;

      {
      int nxg = nx*(length+lengthpml[0]+lengthpml[1])/length;
      border ag(t=-lengthpml[0],length+lengthpml[1]) {x=t; y=-lengthpml[2]; label=lab[0];}
      border bg(t=-lengthpml[2],length+lengthpml[3]) {x=length+lengthpml[1]; y=t; label=lab[1];}
      border cg(t=length+lengthpml[1],-lengthpml[0]) {x=t; y=length+lengthpml[3]; label=lab[2];}
      border dg(t=length+lengthpml[3],-lengthpml[2]) {x=-lengthpml[0]; y=t; label=lab[3];}

      mesh Th2g = buildmesh(bba(-nx)+bbb(-nx)+bbc(-nx)+bbd(-nx)+ag(nxg)+bg(nxg)+cg(nxg)+dg(nxg),fixedborder=1,nbvx=10000000);
      //cout<<"LPML:"<<lengthpml[0]<<lengthpml[1]<<lengthpml[2]<<lengthpml[3]<<lpmlg<<endl; exit(0);
      Th = Th2+Th2g;
      //plot(Th);
      /*fespace Ph(Th2,P0);
      Ph tabh; 
      int nbTriangles = Th2.nt;
      real [int]  tab(nbTriangles);
      for (int i=0;i<nbTriangles;i++) tab[i]=0.;
      int it=0;
      real[int]  RayRef(4);
      RayRef[0]=1./3; 
      RayRef[1]=1./3;
      RayRef[2]=1;
      RayRef[3]=1.;
      int tt=0;
      //tt= RayTracer(Th,it, RayRef,tab);
      //cout<<"TT="<<tt<<endl;

      plot( Th );
      cout<<endl;
      int nbrrays = 200; // lance 2*Nbrrays
      tt= MeshRayTracer(Th2, nbrrays,tab);
      for (int i=0;i<nbTriangles;i++){tabh[][i]=tab[i];}// cout<<" tab["<<i<<"]="<<tab[i]<<" ";
      plot(tabh,fill=1,value=1,ps="raycaster.ps",cmm="Detection of the trapping zone");
      cout<<endl;
      //medit("maillage",Th);

       // Visible Area test
      real [int]  tabvisiblearea(nbTriangles);
      for (int i=0;i<nbTriangles;i++) tabvisiblearea[i]=0.;
      //int threshold =15000;
      int threshold =rint(0.8*tabh[].max);
      tt= MeshRayTracerVisibleArea(Th2, nbrrays,tab,threshold,tabvisiblearea);
      for (int i=0;i<nbTriangles;i++){tabh[][i]=tabvisiblearea[i];}// cout<<" tab["<<i<<"]="<<tab[i]<<" ";
      plot(tabh,fill=1,value=1,ps="raycastervisiblearea.ps",cmm="Detection of the (in)visible areas");
      cout<<endl;*/
      }

      /*
      {
      real nloc = nppwl/ffddmsplit*length/lambda;
      int nx = rint(nloc*(length+lengthpml[0]+lengthpml[1])/length);
      int ny = rint(nloc*(length+lengthpml[2]+lengthpml[3])/length);
      nx += nx%2;
      ny += ny%2;
