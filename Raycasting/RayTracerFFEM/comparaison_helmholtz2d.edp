  plot(tabh,fill=1,value=1,ps="raycaster.ps",cmm="Detection of the trapping zone");
  //cout<<endl;
  //medit("maillage",Th);

  // Visible Area test
  real [int]  tabvisiblearea(nbTriangles);
  for (int i=0;i<nbTriangles;i++) tabvisiblearea[i]=0.;
  //int threshold =15000;
  int threshold =rint(0.8*tabh[].max);
  tt= MeshRayTracerVisibleArea(Th2, nbrrays,tab,threshold,tabvisiblearea);
  for (int i=0;i<nbTriangles;i++){tabh[][i]=tabvisiblearea[i];}// cout<<" tab["<<i<<"]="<<tab[i]<<" ";
  plot(tabh,fill=1,value=1,ps="raycastervisiblearea.ps",cmm="Detection of the (in)visible areas");
